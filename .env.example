# Copy this file to .env and fill in the values from your Supabase project
# (Supabase dashboard → Project Settings → API / Database). .env is git-ignored.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Database → Connect → "Session pooler" connection string, with your DB password filled in
DATABASE_URL=
SITE_URL=https://order-priority.vercel.app

# Online payments (Razorpay) — test keys first, live keys after KYC
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Order emails (SMTP) — Gmail App Password now; any SMTP later
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
